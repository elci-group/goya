// ============================================================
// zcode-monitor.gscene — GY-ZCODE/1 read-only session monitor.
//
// Contract (docs/goya-zcode.md): the host overrides `title`,
// `status` and the transcript rows `row_00`..`row_13` with live
// text every frame (calculator with_result pattern). `quit` is
// the only interactive node.
//
// Run it:
//   cargo run --bin zcode-monitor -- --live --workspace /path/to/ws
// ============================================================

@ontology zcode_monitor {

    @cell window {
        position: (0, 0, 0)
        extent: (400, 320, 0)
        fill: #14141c

        // ---- Header -------------------------------------------
        @cell header {
            position: (0, 0, 0)
            extent: (400, 28, 0)
            fill: #1e1e28

            @cell title {
                position: (8, 7, 0)
                extent: (300, 14, 0)
                text: "zcode monitor"
                text-size: 10
                fill: #9aa0b0
            }

            @cell status {
                position_p: (0.97, 0.5, 0)
                extent: (90, 14, 0)
                text: "connecting"
                text-size: 9
                fill: #00cc66
                text-anchor: end
            }
        }

        // ---- Transcript rows (host-overridden each frame) ------
        @cell row_00 { position: (6, 32, 0);   extent: (388, 18, 0); fill: #1c1c24; text: ""; text-size: 9 }
        @cell row_01 { position: (6, 50, 0);   extent: (388, 18, 0); fill: #202028; text: ""; text-size: 9 }
        @cell row_02 { position: (6, 68, 0);   extent: (388, 18, 0); fill: #1c1c24; text: ""; text-size: 9 }
        @cell row_03 { position: (6, 86, 0);   extent: (388, 18, 0); fill: #202028; text: ""; text-size: 9 }
        @cell row_04 { position: (6, 104, 0);  extent: (388, 18, 0); fill: #1c1c24; text: ""; text-size: 9 }
        @cell row_05 { position: (6, 122, 0);  extent: (388, 18, 0); fill: #202028; text: ""; text-size: 9 }
        @cell row_06 { position: (6, 140, 0);  extent: (388, 18, 0); fill: #1c1c24; text: ""; text-size: 9 }
        @cell row_07 { position: (6, 158, 0);  extent: (388, 18, 0); fill: #202028; text: ""; text-size: 9 }
        @cell row_08 { position: (6, 176, 0);  extent: (388, 18, 0); fill: #1c1c24; text: ""; text-size: 9 }
        @cell row_09 { position: (6, 194, 0);  extent: (388, 18, 0); fill: #202028; text: ""; text-size: 9 }
        @cell row_10 { position: (6, 212, 0);  extent: (388, 18, 0); fill: #1c1c24; text: ""; text-size: 9 }
        @cell row_11 { position: (6, 230, 0);  extent: (388, 18, 0); fill: #202028; text: ""; text-size: 9 }
        @cell row_12 { position: (6, 248, 0);  extent: (388, 18, 0); fill: #1c1c24; text: ""; text-size: 9 }
        @cell row_13 { position: (6, 266, 0);  extent: (388, 18, 0); fill: #202028; text: ""; text-size: 9 }

        // ---- Footer --------------------------------------------
        // Composer input (GY-ZCODE-002): host-owned focus; enter echoes
        // lines as [local] tail entries, never sent to the agent. The
        // parser gains @input in parallel (J1); until then the monitor
        // bin strips this node as a fallback so the scene still parses.
        // Placed left of `quit` (290, 292) with no overlap.
        @input composer {
            position: (6, 292, 0)
            extent: (270, 24, 0)
            fill: #101016
            stroke: #3a3a46
            stroke-width: 1
            text: "type here…"
            text-size: 9
        }

        @button quit {
            position: (290, 292, 0)
            extent: (100, 24, 0)
            fill: #8a2a2a
            text: "Quit"
            text-size: 9
        }
    }
}
