    @shape star { path: "M 122 73.48 L 126.443 86.084 L 139.804 86.415 L 129.19 94.536 L 133.003 107.345 L 122 99.76 L 110.997 107.345 L 114.81 94.536 L 104.196 86.415 L 117.557 86.084 Z"; fill: #e0a81e; }
    @shape card_r { rect: (162, 40, 72, 100.8, 10); fill: #fffaf0; stroke: #e0a81e; stroke-width: 3; }
    @shape heart { path: "M 198 110.2 C 183.6 99.4 178.2 90.4 181.8 81.4 C 185.4 73.12 195.12 73.12 198 81.4 C 200.88 73.12 210.6 73.12 214.2 81.4 C 217.8 90.4 212.4 99.4 198 110.2 Z"; fill: #d64550; }
    @dimension look { @value plain { } }
  }
  // A colour-key chip. On a tile it shows the colour dealt to the tile on
  // this screen (dealt), or a grey outline when the tile has no key. In
  // Settings, four dots mean the app takes part in colour keys.
  @graphic chip {
    id: "graphic.chip";
    canvas: (120, 48);
    @shape red { rect: (4, 4, 112, 40, 20); fill: #d64550; }
    @shape green { rect: (4, 4, 112, 40, 20); fill: #2e9e4f; }
    @shape yellow { rect: (4, 4, 112, 40, 20); fill: #e0a81e; }
    @shape blue { rect: (4, 4, 112, 40, 20); fill: #4b6fd6; }
    @shape none { rect: (6, 6, 108, 36, 18); fill: #fffaf0; stroke: #9aa5b1; stroke-width: 5; }
    @shape dot_red { ellipse: (22, 24, 11, 11); fill: #d64550; }
    @shape dot_green { ellipse: (47, 24, 11, 11); fill: #2e9e4f; }
    @shape dot_yellow { ellipse: (73, 24, 11, 11); fill: #e0a81e; }
    @shape dot_blue { ellipse: (98, 24, 11, 11); fill: #4b6fd6; }
    @dimension hue {
      @value red { hide: green, yellow, blue, none, dot_red, dot_green, dot_yellow, dot_blue; }
      @value green { hide: red, yellow, blue, none, dot_red, dot_green, dot_yellow, dot_blue; }
      @value yellow { hide: red, green, blue, none, dot_red, dot_green, dot_yellow, dot_blue; }
      @value blue { hide: red, green, yellow, none, dot_red, dot_green, dot_yellow, dot_blue; }
      @value all { hide: red, green, yellow, blue, none; }
      @value none { hide: red, green, yellow, blue, dot_red, dot_green, dot_yellow, dot_blue; }
    }
  }
  @apps tv { id: "apps.tv"; app youtube: "youtube.leanback.v4"; app netflix: "netflix"; app prime: "amazon"; app browser: "com.webos.app.browser"; app livetv: "com.webos.app.livetv"; app pairs: "com.goya.arachnid.pairs"; }
  @cell root { id: "root"; fill: #6f8fb0; sky: local;
    @cell logo { id: "logo"; position_p: (0.04, 0.025, 0); extent_p: (0.05625, 0.1, 0);
      @draw logo { channel: "red" when state.screen is 2; channel: "green" when state.screen is 3; channel: "yellow" when state.screen is 4; channel: "blue" when state.screen is 5; channel: "home"; }
    }
    @cell brand { id: "brand"; position_p: (0.105, 0.04, 0); extent_p: (0.11, 0.08, 0); fill: #fffaf0; text: "Goya"; text-size-p: 0.7; text-anchor: middle; }
    @cell who_1 { id: "who.1"; present-when: state.profile is 1; position_p: (0.8, 0.05, 0); extent_p: (0.16, 0.055, 0); fill: #fffaf0; text: "Owner"; text-size-p: 0.66; text-anchor: middle; }
    @cell who_2 { id: "who.2"; present-when: state.profile is 2; position_p: (0.8, 0.05, 0); extent_p: (0.16, 0.055, 0); fill: #fffaf0; text: "Family"; text-size-p: 0.66; text-anchor: middle; }
    @cell who_3 { id: "who.3"; present-when: state.profile is 3; position_p: (0.8, 0.05, 0); extent_p: (0.16, 0.055, 0); fill: #fffaf0; text: "Guest"; text-size-p: 0.66; text-anchor: middle; }
    @cell notice { id: "notice"; position_p: (0.04, 0.9, 0); extent_p: (0.92, 0.06, 0); fill: #fffaf0; text-from: state.notice; text-size-p: 0.5; text-anchor: middle; }
    @cell picker { id: "screen.picker"; present-when: state.screen is 0; position_p: (0.04, 0.15, 0); extent_p: (0.92, 0.7, 0); appear-s: 0.4; appear-from-p: (0, 0.03, 0);
      @cell picker_heading { id: "picker.heading"; position_p: (0.28, 0, 0); extent_p: (0.44, 0.18, 0); fill: #fffaf0; text: "Choose a profile"; text-size-p: 0.6; text-anchor: middle; }
      @button pick_1 { id: "pick.1"; position_p: (0, 0.3, 0); extent_p: (0.3, 0.5, 0); text: "Owner"; text-size-p: 0.16; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Profile Owner"; hint: "Press OK to use this profile"; } }
      @button pick_2 { id: "pick.2"; position_p: (0.35, 0.3, 0); extent_p: (0.3, 0.5, 0); text: "Family"; text-size-p: 0.16; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Profile Family"; hint: "Press OK to use this profile"; } }
      @button pick_3 { id: "pick.3"; position_p: (0.7, 0.3, 0); extent_p: (0.3, 0.5, 0); text: "Guest"; text-size-p: 0.16; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Profile Guest"; hint: "Press OK to use this profile"; } }
    }
    @cell home { id: "screen.home"; present-when: state.screen is 1; position_p: (0.04, 0.15, 0); extent_p: (0.92, 0.55, 0); appear-s: 0.4; appear-from-p: (0, 0.03, 0);
      @cell home_heading { id: "home.heading"; position_p: (0, 0, 0); extent_p: (0.2, 0.15, 0); fill: #fffaf0; text: "Favourites"; text-size-p: 0.6; text-anchor: middle; }
      @cell legend { id: "home.legend"; position_p: (0.5, 0.02, 0); extent_p: (0.5, 0.11, 0); fill: #fffaf0;
        @cell c0 { id: "home.legend.red"; position_p: (0.02, 0.2, 0); extent_p: (0.11, 0.6, 0); @draw chip { hue: "red"; } }
        @cell c1 { id: "home.legend.green"; position_p: (0.14, 0.2, 0); extent_p: (0.11, 0.6, 0); @draw chip { hue: "green"; } }
        @cell c2 { id: "home.legend.yellow"; position_p: (0.26, 0.2, 0); extent_p: (0.11, 0.6, 0); @draw chip { hue: "yellow"; } }
        @cell c3 { id: "home.legend.blue"; position_p: (0.38, 0.2, 0); extent_p: (0.11, 0.6, 0); @draw chip { hue: "blue"; } }
        @cell legend_text { id: "home.legend.text"; position_p: (0.51, 0.15, 0); extent_p: (0.47, 0.7, 0); text: "keys pick the app wearing it"; text-size-p: 0.62; }
      }
