        @cell art { id: "apps.pairs.art"; position_p: (0.03, 0.1, 0); extent_p: (0.5739, 0.8, 0); @draw logo_pairs { look: "plain"; } }
        @cell label { id: "apps.pairs.label"; position_p: (0.62, 0.39, 0); extent_p: (0.36, 0.22, 0); text: "Goya Pairs"; text-size-p: 0.67; text-anchor: start; }
        @cell chip { id: "apps.pairs.chip"; position_p: (0.62, 0.12, 0); extent_p: (0.15, 0.149, 0); @draw chip { hue: dealt; hue: "none"; } }
      }
    }
    @cell panel_household { id: "screen.household"; fill: #fffaf0; present-when: state.screen is 3; position_p: (0.04, 0.15, 0); extent_p: (0.92, 0.55, 0); appear-s: 0.4; appear-from-p: (0, 0.03, 0);
      @cell household_heading { id: "household.heading"; position_p: (0, 0, 0); extent_p: (1, 0.15, 0); text: "Household"; text-size-p: 0.6; }
      @cell household_detail { id: "household.detail"; position_p: (0, 0.12, 0); extent_p: (1, 0.1, 0); text-from: state.link_detail; text-size-p: 0.5; }
      @cell household_unpaired { id: "household.unpaired"; present-when: state.link is 0; position_p: (0, 0.26, 0); extent_p: (1, 0.35, 0); text: "Start bloom-tv on your desktop, then pair this TV to see your configured devices."; wrap: 65; text-size-p: 0.17; }
      @cell household_pairing { id: "household.pairing"; present-when: state.link is 1; position_p: (0, 0.26, 0); extent_p: (1, 0.45, 0);
        @cell code { id: "household.code"; position_p: (0, 0, 0); extent_p: (0.4, 0.4, 0); text-from: state.pair_code; text-size-p: 0.8; }
        @cell compare { id: "household.compare"; position_p: (0, 0.5, 0); extent_p: (1, 0.45, 0); text: "Compare with the code in bloom-tv. Confirm on both screens only when they match."; wrap: 65; text-size-p: 0.25; }
      }
      @cell household_waiting { id: "household.waiting"; present-when: state.link is 2; position_p: (0, 0.26, 0); extent_p: (1, 0.4, 0); text: "Waiting for desktop confirmation. Run bloom-tv confirm --state DIR --code with the matching code."; wrap: 65; text-size-p: 0.18; }
      @cell household_ready { id: "household.ready"; present-when: state.link is 3; position_p: (0, 0.24, 0); extent_p: (1, 0.55, 0);
        @cell device_1 { id: "household.d1"; present-when: state.devices at-least 1; position_p: (0, 0.00, 0); extent_p: (1, 0.22, 0);
          @cell name { id: "household.d1.name"; position_p: (0, 0, 0); extent_p: (0.23, 1, 0); text-from: state.d1_name; text-size-p: 0.38; }
          @cell reading { id: "household.d1.state"; position_p: (0.25, 0, 0); extent_p: (0.32, 1, 0); text-from: state.d1_state; text-size-p: 0.35; }
          @cell gauge { id: "household.d1.cpu"; position_p: (0.6, 0.26, 0); extent_p: (0.18, 0.48, 0);
            @draw cpu_gauge { level: "q0" when state.d1_cpu is 0; level: "q1" when state.d1_cpu is 1; level: "q2" when state.d1_cpu is 2; level: "q3" when state.d1_cpu is 3; level: "q4" when state.d1_cpu is 4; level: "unknown"; }
          }
          @button wake_1 { id: "household.d1.wake"; present-when: state.d1_wake is true; position_p: (0.81, 0, 0); extent_p: (0.19, 1, 0); text: "Wake"; text-size-p: 0.4; fill: #d3ecd9; stroke: #2e9e4f; stroke-width-p: 0.02; @iden { label: "Wake device 1"; hint: "Send Wake-on-LAN"; } }
        }
        @cell device_2 { id: "household.d2"; present-when: state.devices at-least 2; position_p: (0, 0.25, 0); extent_p: (1, 0.22, 0);
          @cell name { id: "household.d2.name"; position_p: (0, 0, 0); extent_p: (0.23, 1, 0); text-from: state.d2_name; text-size-p: 0.38; }
          @cell reading { id: "household.d2.state"; position_p: (0.25, 0, 0); extent_p: (0.32, 1, 0); text-from: state.d2_state; text-size-p: 0.35; }
          @cell gauge { id: "household.d2.cpu"; position_p: (0.6, 0.26, 0); extent_p: (0.18, 0.48, 0);
            @draw cpu_gauge { level: "q0" when state.d2_cpu is 0; level: "q1" when state.d2_cpu is 1; level: "q2" when state.d2_cpu is 2; level: "q3" when state.d2_cpu is 3; level: "q4" when state.d2_cpu is 4; level: "unknown"; }
          }
          @button wake_2 { id: "household.d2.wake"; present-when: state.d2_wake is true; position_p: (0.81, 0, 0); extent_p: (0.19, 1, 0); text: "Wake"; text-size-p: 0.4; fill: #d3ecd9; stroke: #2e9e4f; stroke-width-p: 0.02; @iden { label: "Wake device 2"; hint: "Send Wake-on-LAN"; } }
        }
        @cell device_3 { id: "household.d3"; present-when: state.devices at-least 3; position_p: (0, 0.50, 0); extent_p: (1, 0.22, 0);
          @cell name { id: "household.d3.name"; position_p: (0, 0, 0); extent_p: (0.23, 1, 0); text-from: state.d3_name; text-size-p: 0.38; }
          @cell reading { id: "household.d3.state"; position_p: (0.25, 0, 0); extent_p: (0.32, 1, 0); text-from: state.d3_state; text-size-p: 0.35; }
          @cell gauge { id: "household.d3.cpu"; position_p: (0.6, 0.26, 0); extent_p: (0.18, 0.48, 0);
            @draw cpu_gauge { level: "q0" when state.d3_cpu is 0; level: "q1" when state.d3_cpu is 1; level: "q2" when state.d3_cpu is 2; level: "q3" when state.d3_cpu is 3; level: "q4" when state.d3_cpu is 4; level: "unknown"; }
          }
          @button wake_3 { id: "household.d3.wake"; present-when: state.d3_wake is true; position_p: (0.81, 0, 0); extent_p: (0.19, 1, 0); text: "Wake"; text-size-p: 0.4; fill: #d3ecd9; stroke: #2e9e4f; stroke-width-p: 0.02; @iden { label: "Wake device 3"; hint: "Send Wake-on-LAN"; } }
        }
        @cell device_4 { id: "household.d4"; present-when: state.devices at-least 4; position_p: (0, 0.75, 0); extent_p: (1, 0.22, 0);
          @cell name { id: "household.d4.name"; position_p: (0, 0, 0); extent_p: (0.23, 1, 0); text-from: state.d4_name; text-size-p: 0.38; }
          @cell reading { id: "household.d4.state"; position_p: (0.25, 0, 0); extent_p: (0.32, 1, 0); text-from: state.d4_state; text-size-p: 0.35; }
          @cell gauge { id: "household.d4.cpu"; position_p: (0.6, 0.26, 0); extent_p: (0.18, 0.48, 0);
            @draw cpu_gauge { level: "q0" when state.d4_cpu is 0; level: "q1" when state.d4_cpu is 1; level: "q2" when state.d4_cpu is 2; level: "q3" when state.d4_cpu is 3; level: "q4" when state.d4_cpu is 4; level: "unknown"; }
          }
          @button wake_4 { id: "household.d4.wake"; present-when: state.d4_wake is true; position_p: (0.81, 0, 0); extent_p: (0.19, 1, 0); text: "Wake"; text-size-p: 0.4; fill: #d3ecd9; stroke: #2e9e4f; stroke-width-p: 0.02; @iden { label: "Wake device 4"; hint: "Send Wake-on-LAN"; } }
        }
      }
      @button hh_pair { id: "household.pair"; present-when: state.link is 0; position_p: (0, 0.84, 0); extent_p: (0.23, 0.14, 0); text: "Pair desktop"; text-size-p: 0.38; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Pair desktop"; hint: "Household connection"; } }
      @button hh_confirm { id: "household.confirm"; present-when: state.link is 1; position_p: (0, 0.84, 0); extent_p: (0.23, 0.14, 0); text: "Codes match"; text-size-p: 0.38; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Codes match"; hint: "Household connection"; } }
      @button hh_cancel { id: "household.cancel"; present-when: state.link is 1; position_p: (0.25, 0.84, 0); extent_p: (0.23, 0.14, 0); text: "Cancel"; text-size-p: 0.38; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Cancel"; hint: "Household connection"; } }
      @button hh_cancel_wait { id: "household.cancel_wait"; present-when: state.link is 2; position_p: (0, 0.84, 0); extent_p: (0.23, 0.14, 0); text: "Cancel"; text-size-p: 0.38; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Cancel"; hint: "Household connection"; } }
      @button hh_refresh { id: "household.refresh"; present-when: state.link is 3; position_p: (0, 0.84, 0); extent_p: (0.23, 0.14, 0); text: "Refresh"; text-size-p: 0.38; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Refresh"; hint: "Household connection"; } }
      @button hh_retry { id: "household.retry"; present-when: state.link is 6; position_p: (0, 0.84, 0); extent_p: (0.23, 0.14, 0); text: "Retry"; text-size-p: 0.38; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Retry"; hint: "Household connection"; } }
      @button hh_pair_again { id: "household.pair_again"; present-when: state.link is 7; position_p: (0, 0.84, 0); extent_p: (0.23, 0.14, 0); text: "Pair again"; text-size-p: 0.38; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.02; @iden { label: "Pair again"; hint: "Household connection"; } }
      @button hh_forget { id: "household.forget"; present-when: state.link at-least 2; position_p: (0.5, 0.84, 0); extent_p: (0.3, 0.14, 0); text: "Forget desktop"; text-size-p: 0.38; fill: #d9e2ec; @iden { label: "Forget desktop"; hint: "End this pairing"; } }
    }
    @cell panel_broadcast { id: "screen.broadcast"; fill: #fffaf0; present-when: state.screen is 4; position_p: (0.04, 0.15, 0); extent_p: (0.92, 0.55, 0); appear-s: 0.4; appear-from-p: (0, 0.03, 0);
      @cell broadcast_heading { id: "broadcast.heading"; position_p: (0, 0, 0); extent_p: (1, 0.15, 0); text: "Broadcast"; text-size-p: 0.6; }
      @cell broadcast_body { id: "broadcast.body"; position_p: (0, 0.25, 0); extent_p: (1, 0.4, 0); text: "OBS scenes, recording and streaming will be controlled from here through the paired desktop. Nothing is connected yet."; wrap: 70; text-size-p: 0.14; }
    }
    @cell panel_activity { id: "screen.activity"; fill: #fffaf0; present-when: state.screen is 5; position_p: (0.04, 0.15, 0); extent_p: (0.92, 0.55, 0); appear-s: 0.4; appear-from-p: (0, 0.03, 0);
      @cell activity_heading { id: "activity.heading"; position_p: (0, 0, 0); extent_p: (1, 0.15, 0); text: "Activity"; text-size-p: 0.6; }
      @cell activity_body { id: "activity.body"; position_p: (0, 0.25, 0); extent_p: (1, 0.4, 0); text: "Notifications and resource use from your devices will appear here. Nothing is connected yet."; wrap: 70; text-size-p: 0.14; }
    }
    @cell panel_settings { id: "screen.settings"; present-when: state.screen is 6; fill: #fffaf0; position_p: (0.04, 0.15, 0); extent_p: (0.92, 0.55, 0); appear-s: 0.4; appear-from-p: (0, 0.03, 0);
      @cell settings_heading { id: "settings.heading"; position_p: (0, 0, 0); extent_p: (1, 0.13, 0); text: "Settings"; text-size-p: 0.6; }
      @cell settings_about { id: "settings.about"; position_p: (0, 0.13, 0); extent_p: (1, 0.12, 0); text: "Colour keys: on each screen the first four included apps get red, green, yellow and blue. Omit apps to choose which."; text-size-p: 0.36; }
      @cell row_youtube { id: "settings.youtube"; position_p: (0, 0.28, 0); extent_p: (0.49, 0.21, 0);
        @cell art { id: "settings.youtube.art"; position_p: (0, 0.08, 0); extent_p: (0.2158, 0.84, 0); @draw logo_youtube { look: "plain"; } }
        @cell chip { id: "settings.youtube.chip"; position_p: (0.235, 0.375, 0); extent_p: (0.09, 0.249, 0); @draw chip { hue: "all" when state.cc_youtube is true; hue: "none"; } }
        @cell name { id: "settings.youtube.name"; position_p: (0.34, 0.3, 0); extent_p: (0.25, 0.4, 0); text: "YouTube"; text-size-p: 0.65; }
        @button include_youtube { id: "settings.youtube.include"; position_p: (0.6, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Include"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Include YouTube in colour keys"; hint: "Press OK"; } }
        @button omit_youtube { id: "settings.youtube.omit"; position_p: (0.8, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Omit"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Omit YouTube from colour keys"; hint: "Press OK"; } }
      }
      @cell row_netflix { id: "settings.netflix"; position_p: (0.51, 0.28, 0); extent_p: (0.49, 0.21, 0);
        @cell art { id: "settings.netflix.art"; position_p: (0, 0.08, 0); extent_p: (0.2158, 0.84, 0); @draw logo_netflix { look: "plain"; } }
        @cell chip { id: "settings.netflix.chip"; position_p: (0.235, 0.375, 0); extent_p: (0.09, 0.249, 0); @draw chip { hue: "all" when state.cc_netflix is true; hue: "none"; } }
        @cell name { id: "settings.netflix.name"; position_p: (0.34, 0.3, 0); extent_p: (0.25, 0.4, 0); text: "Netflix"; text-size-p: 0.65; }
        @button include_netflix { id: "settings.netflix.include"; position_p: (0.6, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Include"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Include Netflix in colour keys"; hint: "Press OK"; } }
        @button omit_netflix { id: "settings.netflix.omit"; position_p: (0.8, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Omit"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Omit Netflix from colour keys"; hint: "Press OK"; } }
      }
      @cell row_prime { id: "settings.prime"; position_p: (0, 0.52, 0); extent_p: (0.49, 0.21, 0);
        @cell art { id: "settings.prime.art"; position_p: (0, 0.08, 0); extent_p: (0.2158, 0.84, 0); @draw logo_prime { look: "plain"; } }
        @cell chip { id: "settings.prime.chip"; position_p: (0.235, 0.375, 0); extent_p: (0.09, 0.249, 0); @draw chip { hue: "all" when state.cc_prime is true; hue: "none"; } }
        @cell name { id: "settings.prime.name"; position_p: (0.34, 0.3, 0); extent_p: (0.25, 0.4, 0); text: "Prime Video"; text-size-p: 0.65; }
        @button include_prime { id: "settings.prime.include"; position_p: (0.6, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Include"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Include Prime Video in colour keys"; hint: "Press OK"; } }
        @button omit_prime { id: "settings.prime.omit"; position_p: (0.8, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Omit"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Omit Prime Video from colour keys"; hint: "Press OK"; } }
      }
      @cell row_browser { id: "settings.browser"; position_p: (0.51, 0.52, 0); extent_p: (0.49, 0.21, 0);
        @cell art { id: "settings.browser.art"; position_p: (0, 0.08, 0); extent_p: (0.2158, 0.84, 0); @draw logo_browser { look: "plain"; } }
        @cell chip { id: "settings.browser.chip"; position_p: (0.235, 0.375, 0); extent_p: (0.09, 0.249, 0); @draw chip { hue: "all" when state.cc_browser is true; hue: "none"; } }
        @cell name { id: "settings.browser.name"; position_p: (0.34, 0.3, 0); extent_p: (0.25, 0.4, 0); text: "Web Browser"; text-size-p: 0.65; }
        @button include_browser { id: "settings.browser.include"; position_p: (0.6, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Include"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Include Web Browser in colour keys"; hint: "Press OK"; } }
        @button omit_browser { id: "settings.browser.omit"; position_p: (0.8, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Omit"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Omit Web Browser from colour keys"; hint: "Press OK"; } }
      }
      @cell row_livetv { id: "settings.livetv"; position_p: (0, 0.76, 0); extent_p: (0.49, 0.21, 0);
        @cell art { id: "settings.livetv.art"; position_p: (0, 0.08, 0); extent_p: (0.2158, 0.84, 0); @draw logo_livetv { look: "plain"; } }
        @cell chip { id: "settings.livetv.chip"; position_p: (0.235, 0.375, 0); extent_p: (0.09, 0.249, 0); @draw chip { hue: "all" when state.cc_livetv is true; hue: "none"; } }
        @cell name { id: "settings.livetv.name"; position_p: (0.34, 0.3, 0); extent_p: (0.25, 0.4, 0); text: "Live TV"; text-size-p: 0.65; }
        @button include_livetv { id: "settings.livetv.include"; position_p: (0.6, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Include"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Include Live TV in colour keys"; hint: "Press OK"; } }
        @button omit_livetv { id: "settings.livetv.omit"; position_p: (0.8, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Omit"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Omit Live TV from colour keys"; hint: "Press OK"; } }
      }
      @cell row_pairs { id: "settings.pairs"; position_p: (0.51, 0.76, 0); extent_p: (0.49, 0.21, 0);
        @cell art { id: "settings.pairs.art"; position_p: (0, 0.08, 0); extent_p: (0.2158, 0.84, 0); @draw logo_pairs { look: "plain"; } }
        @cell chip { id: "settings.pairs.chip"; position_p: (0.235, 0.375, 0); extent_p: (0.09, 0.249, 0); @draw chip { hue: "all" when state.cc_pairs is true; hue: "none"; } }
        @cell name { id: "settings.pairs.name"; position_p: (0.34, 0.3, 0); extent_p: (0.25, 0.4, 0); text: "Goya Pairs"; text-size-p: 0.65; }
        @button include_pairs { id: "settings.pairs.include"; position_p: (0.6, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Include"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Include Goya Pairs in colour keys"; hint: "Press OK"; } }
        @button omit_pairs { id: "settings.pairs.omit"; position_p: (0.8, 0.12, 0); extent_p: (0.19, 0.76, 0); text: "Omit"; text-size-p: 0.36; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "Omit Goya Pairs from colour keys"; hint: "Press OK"; } }
      }
    }
    @cell channels { id: "channels"; present-when: state.screen at-least 1; position_p: (0.04, 0.73, 0); extent_p: (0.92, 0.14, 0);
      @button ch_home { id: "channel.home"; position_p: (0.000, 0, 0); extent_p: (0.13, 1, 0); text: "Home"; text-size-p: 0.22; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.04; @iden { label: "Home"; hint: "Show favourites"; } }
      @button ch_apps { id: "channel.apps"; position_p: (0.145, 0, 0); extent_p: (0.13, 1, 0); text: "Applications"; text-size-p: 0.22; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.04; @iden { label: "Applications"; hint: "Show all applications"; } }
      @button ch_household { id: "channel.household"; position_p: (0.290, 0, 0); extent_p: (0.13, 1, 0); text: "Household"; text-size-p: 0.22; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.04; @iden { label: "Household"; hint: "Show household devices"; } }
      @button ch_broadcast { id: "channel.broadcast"; position_p: (0.435, 0, 0); extent_p: (0.13, 1, 0); text: "Broadcast"; text-size-p: 0.22; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.04; @iden { label: "Broadcast"; hint: "Show broadcast controls"; } }
      @button ch_activity { id: "channel.activity"; position_p: (0.580, 0, 0); extent_p: (0.13, 1, 0); text: "Activity"; text-size-p: 0.22; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.04; @iden { label: "Activity"; hint: "Show activity"; } }
      @button ch_settings { id: "channel.settings"; position_p: (0.725, 0, 0); extent_p: (0.13, 1, 0); text: "Settings"; text-size-p: 0.22; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.04; @iden { label: "Settings"; hint: "Choose which apps the colour keys select"; } }
      @button ch_profiles { id: "channel.profiles"; position_p: (0.870, 0, 0); extent_p: (0.13, 1, 0); text: "Profiles"; text-size-p: 0.22; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.04; @iden { label: "Profiles"; hint: "Choose another profile"; } }
    }
  }
