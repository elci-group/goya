// Goya Launcher: a home screen for LG webOS TVs, written only in .gscene and
// compiled by Arachnid (docs/arachnid/launcher.md, Slice 1).
//
// Profiles choose favourites. The four colour keys pick apps: on each
// screen the first four included tiles are dealt red, green, yellow and
// blue (colour-group: deal), each tile wears its colour, and the key jumps
// to it. Settings includes or omits each app. Panels are on the channel bar.
// The background is the live sky over the TV's time zone (sky: local); all
// text sits on opaque cards, so contrast holds whatever the sky shows.
// Applications open through @apps. The app ids below are LG's usual ids and
// cannot be discovered on this TV: listApps and listLaunchPoints are denied.
// Household pairs with bloom-tv (Slice 2). Broadcast and Activity remain
// unconnected until their peer features exist.
//
// The logo is one @graphic: four channel squares around a home point. It
// follows the open panel (the other squares dim), precomputed as GY-GVI/0.
// Each app tile shows its logo, an @graphic converted from SVG with
// `arachnid import-svg`, above (Favourites) or beside (Applications) its name.
@ontology goya_launcher {
  @persistence { cache_targets: { android: "android.preferences.v1"; linux: "linux.xdg-state.v1"; webos: "webos.local-storage.v1"; }; }
  @state { screen: int = 0 session; profile: int = 0 durable; notice: text = "" session; link: int = 0 host; link_detail: text = "" host; pair_code: text = "" host; devices: int = 0 host; d1_name: text = "" host; d1_state: text = "" host; d1_cpu: int = -1 host; d1_wake: bool = false host; d2_name: text = "" host; d2_state: text = "" host; d2_cpu: int = -1 host; d2_wake: bool = false host; d3_name: text = "" host; d3_state: text = "" host; d3_cpu: int = -1 host; d3_wake: bool = false host; d4_name: text = "" host; d4_state: text = "" host; d4_cpu: int = -1 host; d4_wake: bool = false host; cc_youtube: bool = true durable; cc_netflix: bool = true durable; cc_prime: bool = true durable; cc_browser: bool = true durable; cc_livetv: bool = true durable; cc_pairs: bool = true durable; }
  @graphic logo {
    id: "graphic.logo";
    canvas: (240, 240);
    @shape tile { rect: (8, 8, 224, 224, 48); fill: #2b4c7e; }
    @shape red { rect: (36, 36, 76, 76, 18); fill: #d64550; }
    @shape green { rect: (128, 36, 76, 76, 18); fill: #2e9e4f; }
    @shape yellow { rect: (36, 128, 76, 76, 18); fill: #e0a81e; }
    @shape blue { rect: (128, 128, 76, 76, 18); fill: #4b6fd6; }
    @shape home { ellipse: (120, 120, 14, 14); fill: #f4f1ea; stroke: #2b4c7e; stroke-width: 6; }
    @dimension channel {
      @value home { }
      @value red { fade: green, yellow, blue 0.3; }
      @value green { fade: red, yellow, blue 0.3; }
      @value yellow { fade: red, green, blue 0.3; }
      @value blue { fade: red, green, yellow 0.3; }
    }
  }
  @link household { id: "link.household"; protocol: "goya.lanlink/0"; endpoint: "http://192.168.1.129:8780"; status: state.link; detail: state.link_detail; code: state.pair_code; act wake; act refresh; field devices: state.devices; field d1_name: state.d1_name; field d1_state: state.d1_state; field d1_cpu: state.d1_cpu; field d1_wake: state.d1_wake; field d2_name: state.d2_name; field d2_state: state.d2_state; field d2_cpu: state.d2_cpu; field d2_wake: state.d2_wake; field d3_name: state.d3_name; field d3_state: state.d3_state; field d3_cpu: state.d3_cpu; field d3_wake: state.d3_wake; field d4_name: state.d4_name; field d4_state: state.d4_state; field d4_cpu: state.d4_cpu; field d4_wake: state.d4_wake; }
  @graphic cpu_gauge { id: "graphic.cpu"; canvas: (120, 24);
    @shape b1 { rect: (0, 0, 26, 24, 4); fill: #2e9e4f; }
    @shape b2 { rect: (30, 0, 26, 24, 4); fill: #2e9e4f; }
    @shape b3 { rect: (60, 0, 26, 24, 4); fill: #2e9e4f; }
    @shape b4 { rect: (90, 0, 26, 24, 4); fill: #2e9e4f; }
    @dimension level {
      @value unknown { fade: all 0.12; }
      @value q0 { fade: b1, b2, b3, b4 0.18; }
      @value q1 { fade: b2, b3, b4 0.18; }
      @value q2 { fade: b3, b4 0.18; }
      @value q3 { fade: b4 0.18; }
      @value q4 { }
    }
  }
  // App logos: 16:9 tiles converted from assets/app-logos by
  // `arachnid import-svg` (see assets/app-logos/SOURCES.md).
  @graphic logo_youtube {
    id: "graphic.app.youtube";
    canvas: (320, 180);
    @shape tile { rect: (0, 0, 320, 180, 21); fill: #ffffff; }
    @shape mark { path: "M 222.089 58.604 C 220.599 52.992 216.233 48.597 210.63 47.07 C 200.527 44.343 160 44.343 160 44.343 C 160 44.343 119.473 44.343 109.364 47.07 C 103.764 48.6 99.401 52.994 97.911 58.604 C 95.2 68.778 95.2 90 95.2 90 C 95.2 90 95.2 111.222 97.911 121.396 C 99.401 127.008 103.767 131.403 109.37 132.93 C 119.473 135.657 160 135.657 160 135.657 C 160 135.657 200.527 135.657 210.636 132.93 C 216.239 131.404 220.606 127.009 222.095 121.396 C 224.8 111.222 224.8 90 224.8 90 C 224.8 90 224.8 68.778 222.089 58.604 Z M 146.743 109.267 L 146.743 70.733 L 180.617 90 L 146.743 109.267 Z"; fill: #ff0000; }
    @dimension look { @value plain { } }
  }
  @graphic logo_netflix {
    id: "graphic.app.netflix";
    canvas: (320, 180);
    @shape tile { rect: (0, 0, 320, 180, 21); fill: #000000; }
    @shape mark { path: "M 120.388 18 L 170.476 159.612 C 184.552 159.966 199.612 162 199.612 162 L 148.678 18 L 120.388 18 Z M 171.322 18 L 171.322 73.032 L 199.612 153.012 L 199.612 18 L 171.322 18 Z M 120.388 27 L 120.388 162 C 131.626 160.65 137.248 160.128 148.678 159.612 L 148.678 106.98 L 120.388 27 Z"; fill: #e50914; }
    @dimension look { @value plain { } }
