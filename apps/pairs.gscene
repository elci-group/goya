// Goya Pairs: a picture matching game, written only in .gscene.
// Compiled by Arachnid for LG webOS TVs. The card art and its flip and
// match animations are one @graphic, precomputed at build time as a
// GY-GVI/0 inventory. The game rules are a finite transition table: each
// card is one focus slot holding one button per situation, and exactly
// one of them is present at a time (Arachnid checks this when it builds).
@ontology goya_pairs {
  @persistence { cache_targets: { android: "android.preferences.v1"; linux: "linux.xdg-state.v1"; webos: "webos.local-storage.v1"; }; }
  @graphic card {
    id: "graphic.card";
    canvas: (200, 280);
    @shape glow { rect: (2, 2, 196, 276, 26); fill: #f8e3a0; stroke: #e0a81e; stroke-width: 6; }
    @shape back { rect: (8, 8, 184, 264, 20); fill: #2b4c7e; stroke: #f4f1ea; stroke-width: 6; }
    @shape back_mark { path: "M 100 86 L 150 140 L 100 194 L 50 140 Z"; fill: #3d6aa6; stroke: #9fb8dd; stroke-width: 4; }
    @shape back_dot { ellipse: (100, 140, 16, 16); fill: #f4f1ea; }
    @shape front { rect: (8, 8, 184, 264, 20); fill: #fffaf0; stroke: #2b4c7e; stroke-width: 6; }
    @shape star { path: "M 100.0 93.0 L 112.343 128.011 L 149.455 128.931 L 119.972 151.489 L 130.565 187.069 L 100.0 166.0 L 69.435 187.069 L 80.028 151.489 L 50.545 128.931 L 87.657 128.011 Z"; fill: #e0a81e; }
    @shape heart { path: "M 100 195 C 60 165 45 140 55 115 C 65 92 92 92 100 115 C 108 92 135 92 145 115 C 155 140 140 165 100 195 Z"; fill: #d64550; }
    @shape moon { path: "M 122 88 C 70 92 62 190 124 196 C 84 178 84 108 122 88 Z"; fill: #4b6fd6; }
    @shape sun { ellipse: (100, 142, 42, 42); fill: #f08a24; }
    @shape drop { path: "M 100 82 C 112 108 142 132 142 160 C 142 186 122 202 100 202 C 78 202 58 186 58 160 C 58 132 88 108 100 82 Z"; fill: #2aa198; }
    @shape diamond { path: "M 100 84 L 146 142 L 100 200 L 54 142 Z"; fill: #8e5cc8; }
    @shape bolt { path: "M 114 80 L 66 152 L 97 152 L 84 204 L 136 124 L 105 124 Z"; fill: #3a3a3a; }
    @shape ring { ellipse: (100, 142, 38, 38); stroke: #2e9e4f; stroke-width: 16; }
    @shape sparkle { path: "M 100.0 128.0 L 101.913 137.381 L 109.899 132.101 L 104.619 140.087 L 114.0 142.0 L 104.619 143.913 L 109.899 151.899 L 101.913 146.619 L 100.0 156.0 L 98.087 146.619 L 90.101 151.899 L 95.381 143.913 L 86.0 142.0 L 95.381 140.087 L 90.101 132.101 L 98.087 137.381 Z"; fill: #ffffff; stroke: #e0a81e; stroke-width: 2; }
    @dimension picture {
      @value star { hide: heart, moon, sun, drop, diamond, bolt, ring; }
      @value heart { hide: star, moon, sun, drop, diamond, bolt, ring; }
      @value moon { hide: star, heart, sun, drop, diamond, bolt, ring; }
      @value sun { hide: star, heart, moon, drop, diamond, bolt, ring; }
      @value drop { hide: star, heart, moon, sun, diamond, bolt, ring; }
      @value diamond { hide: star, heart, moon, sun, drop, bolt, ring; }
      @value bolt { hide: star, heart, moon, sun, drop, diamond, ring; }
      @value ring { hide: star, heart, moon, sun, drop, diamond, bolt; }
    }
    @dimension face {
      step-s: 0.05;
      @value down { hide: front, star, heart, moon, sun, drop, diamond, bolt, ring; }
      @value turn_1 { hide: front, star, heart, moon, sun, drop, diamond, bolt, ring; scale: all (0.7, 1); }
      @value turn_2 { hide: front, star, heart, moon, sun, drop, diamond, bolt, ring; scale: all (0.4, 1); }
      @value edge { hide: front, star, heart, moon, sun, drop, diamond, bolt, ring; scale: all (0.08, 1); }
      @value rise_2 { hide: back, back_mark, back_dot; scale: all (0.4, 1); }
      @value rise_1 { hide: back, back_mark, back_dot; scale: all (0.7, 1); }
      @value up { hide: back, back_mark, back_dot; }
    }
    @dimension matched {
      step-s: 0.09;
      @value no { hide: glow, sparkle; }
      @value burst_1 { morph: sparkle "M 100.0 46.0 L 113.777 108.74 L 167.882 74.118 L 133.26 128.223 L 196.0 142.0 L 133.26 155.777 L 167.882 209.882 L 113.777 175.26 L 100.0 238.0 L 86.223 175.26 L 32.118 209.882 L 66.74 155.777 L 4.0 142.0 L 66.74 128.223 L 32.118 74.118 L 86.223 108.74 Z" 0.45; fade: glow 0.5; }
      @value burst_2 { morph: sparkle "M 100.0 46.0 L 113.777 108.74 L 167.882 74.118 L 133.26 128.223 L 196.0 142.0 L 133.26 155.777 L 167.882 209.882 L 113.777 175.26 L 100.0 238.0 L 86.223 175.26 L 32.118 209.882 L 66.74 155.777 L 4.0 142.0 L 66.74 128.223 L 32.118 74.118 L 86.223 108.74 Z" 0.85; fade: sparkle 0.55; fade: glow 0.8; }
      @value yes { hide: sparkle; }
    }
  }
  @state { mup_0: bool = false session; mup_1: bool = false session; mup_2: bool = false session; mup_3: bool = false session; mup_4: bool = false session; mup_5: bool = false session; mup_6: bool = false session; mup_7: bool = false session; mup_8: bool = false session; mup_9: bool = false session; mup_10: bool = false session; mup_11: bool = false session; mup_12: bool = false session; mup_13: bool = false session; mup_14: bool = false session; mup_15: bool = false session; phase: int = 0 session; first_pic: int = 0 session; deal: int = 0 session; pairs: int = 0 session; moves: int = 0 session; games: int = 0 durable; sel_0: bool = false session; sel_1: bool = false session; sel_2: bool = false session; sel_3: bool = false session; sel_4: bool = false session; sel_5: bool = false session; sel_6: bool = false session; sel_7: bool = false session; sel_8: bool = false session; sel_9: bool = false session; sel_10: bool = false session; sel_11: bool = false session; sel_12: bool = false session; sel_13: bool = false session; sel_14: bool = false session; sel_15: bool = false session; sec_0: bool = false session; sec_1: bool = false session; sec_2: bool = false session; sec_3: bool = false session; sec_4: bool = false session; sec_5: bool = false session; sec_6: bool = false session; sec_7: bool = false session; sec_8: bool = false session; sec_9: bool = false session; sec_10: bool = false session; sec_11: bool = false session; sec_12: bool = false session; sec_13: bool = false session; sec_14: bool = false session; sec_15: bool = false session; pair_0: bool = false session; pair_1: bool = false session; pair_2: bool = false session; pair_3: bool = false session; pair_4: bool = false session; pair_5: bool = false session; pair_6: bool = false session; pair_7: bool = false session; }
  @cell root { id: "root"; fill: #f4f1ea; fill-to: #e6edf3; fill-period-s: 30;
    @cell board { id: "board"; position_p: (0.05, 0.12, 0); extent_p: (0.40, 0.84, 0);
      @cell card_0 { id: "card.0"; position_p: (0.0, 0.0, 0); extent_p: (0.1936, 0.235, 0);
        @cell art_0 { id: "card.0.art"; position_p: (0, 0, 0); extent_p: (1, 1, 0);
          @draw card { picture: "sun" when state.deal is 1; picture: "drop"; face: "up" when state.mup_0 is true; face: "up" when state.sel_0 is true; face: "up" when state.sec_0 is true; face: "down"; matched: "yes" when state.mup_0 is true; matched: "no"; }
        }
        @button c0_continue { id: "card.0.c0_continue"; present-when: state.phase is 2; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1: not a match"; hint: "Press OK to turn the two cards back"; } }
        @cell d0_0 { id: "card.0.deal0"; present-when: state.deal is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0);
          @cell d0_0_p0 { id: "card.0.deal0.pick"; present-when: state.phase is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0);
            @button c0_d0_done0 { id: "card.0.c0_d0_done0"; present-when: state.pair_4 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1: drop, matched"; hint: "Already matched"; } }
            @button c0_d0_first { id: "card.0.c0_d0_first"; present-when: state.pair_4 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over"; } }
          }
          @cell d0_0_p1 { id: "card.0.deal0.second"; present-when: state.phase is 1; position_p: (0, 0, 0); extent_p: (1, 1, 0);
            @button c0_d0_done1 { id: "card.0.c0_d0_done1"; present-when: state.pair_4 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1: drop, matched"; hint: "Already matched"; } }
            @cell d0_0_open { id: "card.0.deal0.open"; present-when: state.pair_4 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0);
              @button c0_d0_held { id: "card.0.c0_d0_held"; present-when: state.sel_0 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1: drop, turned over"; hint: "Pick another card to find its pair"; } }
              @cell d0_0_cand { id: "card.0.deal0.candidate"; present-when: state.sel_0 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0);
                @button c0_d0_vs0 { id: "card.0.c0_d0_vs0"; present-when: state.first_pic is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d0_vs1 { id: "card.0.c0_d0_vs1"; present-when: state.first_pic is 1; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d0_vs2 { id: "card.0.c0_d0_vs2"; present-when: state.first_pic is 2; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d0_vs3 { id: "card.0.c0_d0_vs3"; present-when: state.first_pic is 3; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d0_vs4 { id: "card.0.c0_d0_vs4"; present-when: state.first_pic is 4; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d0_vs5 { id: "card.0.c0_d0_vs5"; present-when: state.first_pic is 5; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d0_vs6 { id: "card.0.c0_d0_vs6"; present-when: state.first_pic is 6; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d0_vs7 { id: "card.0.c0_d0_vs7"; present-when: state.first_pic is 7; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
              }
            }
          }
        }
        @cell d1_0 { id: "card.0.deal1"; present-when: state.deal is 1; position_p: (0, 0, 0); extent_p: (1, 1, 0);
          @cell d1_0_p0 { id: "card.0.deal1.pick"; present-when: state.phase is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0);
            @button c0_d1_done0 { id: "card.0.c0_d1_done0"; present-when: state.pair_3 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1: sun, matched"; hint: "Already matched"; } }
            @button c0_d1_first { id: "card.0.c0_d1_first"; present-when: state.pair_3 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over"; } }
          }
          @cell d1_0_p1 { id: "card.0.deal1.second"; present-when: state.phase is 1; position_p: (0, 0, 0); extent_p: (1, 1, 0);
            @button c0_d1_done1 { id: "card.0.c0_d1_done1"; present-when: state.pair_3 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1: sun, matched"; hint: "Already matched"; } }
            @cell d1_0_open { id: "card.0.deal1.open"; present-when: state.pair_3 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0);
              @button c0_d1_held { id: "card.0.c0_d1_held"; present-when: state.sel_0 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1: sun, turned over"; hint: "Pick another card to find its pair"; } }
              @cell d1_0_cand { id: "card.0.deal1.candidate"; present-when: state.sel_0 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0);
                @button c0_d1_vs0 { id: "card.0.c0_d1_vs0"; present-when: state.first_pic is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d1_vs1 { id: "card.0.c0_d1_vs1"; present-when: state.first_pic is 1; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d1_vs2 { id: "card.0.c0_d1_vs2"; present-when: state.first_pic is 2; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d1_vs3 { id: "card.0.c0_d1_vs3"; present-when: state.first_pic is 3; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d1_vs4 { id: "card.0.c0_d1_vs4"; present-when: state.first_pic is 4; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d1_vs5 { id: "card.0.c0_d1_vs5"; present-when: state.first_pic is 5; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d1_vs6 { id: "card.0.c0_d1_vs6"; present-when: state.first_pic is 6; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c0_d1_vs7 { id: "card.0.c0_d1_vs7"; present-when: state.first_pic is 7; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 1, row 1, column 1, face down"; hint: "Press OK to turn it over and compare"; } }
              }
            }
          }
        }
      }
      @cell card_1 { id: "card.1"; position_p: (0.2688, 0.0, 0); extent_p: (0.1936, 0.235, 0);
        @cell art_1 { id: "card.1.art"; position_p: (0, 0, 0); extent_p: (1, 1, 0);
          @draw card { picture: "star" when state.deal is 1; picture: "heart"; face: "up" when state.mup_1 is true; face: "up" when state.sel_1 is true; face: "up" when state.sec_1 is true; face: "down"; matched: "yes" when state.mup_1 is true; matched: "no"; }
        }
        @button c1_continue { id: "card.1.c1_continue"; present-when: state.phase is 2; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2: not a match"; hint: "Press OK to turn the two cards back"; } }
        @cell d0_1 { id: "card.1.deal0"; present-when: state.deal is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0);
          @cell d0_1_p0 { id: "card.1.deal0.pick"; present-when: state.phase is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0);
            @button c1_d0_done0 { id: "card.1.c1_d0_done0"; present-when: state.pair_1 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2: heart, matched"; hint: "Already matched"; } }
            @button c1_d0_first { id: "card.1.c1_d0_first"; present-when: state.pair_1 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over"; } }
          }
