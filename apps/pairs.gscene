            @cell d0_1_open { id: "card.1.deal0.open"; present-when: state.pair_1 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0);
              @button c1_d0_held { id: "card.1.c1_d0_held"; present-when: state.sel_1 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2: heart, turned over"; hint: "Pick another card to find its pair"; } }
              @cell d0_1_cand { id: "card.1.deal0.candidate"; present-when: state.sel_1 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0);
                @button c1_d0_vs0 { id: "card.1.c1_d0_vs0"; present-when: state.first_pic is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c1_d0_vs1 { id: "card.1.c1_d0_vs1"; present-when: state.first_pic is 1; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c1_d0_vs2 { id: "card.1.c1_d0_vs2"; present-when: state.first_pic is 2; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c1_d0_vs3 { id: "card.1.c1_d0_vs3"; present-when: state.first_pic is 3; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c1_d0_vs4 { id: "card.1.c1_d0_vs4"; present-when: state.first_pic is 4; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c1_d0_vs5 { id: "card.1.c1_d0_vs5"; present-when: state.first_pic is 5; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c1_d0_vs6 { id: "card.1.c1_d0_vs6"; present-when: state.first_pic is 6; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over and compare"; } }
                @button c1_d0_vs7 { id: "card.1.c1_d0_vs7"; present-when: state.first_pic is 7; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2, face down"; hint: "Press OK to turn it over and compare"; } }
