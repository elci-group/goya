            @cell d1_1_open { id: "card.1.deal1.open"; present-when: state.pair_0 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0);
              @button c1_d1_held { id: "card.1.c1_d1_held"; present-when: state.sel_1 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0); @iden { label: "Card 2, row 1, column 2: star, turned over"; hint: "Pick another card to find its pair"; } }
              @cell d1_1_cand { id: "card.1.deal1.candidate"; present-when: state.sel_1 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0);
