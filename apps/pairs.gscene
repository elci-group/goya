    }
    @cell panel { id: "panel"; position_p: (0.50, 0.08, 0); extent_p: (0.45, 0.88, 0);
      @cell title { id: "title"; position_p: (0, 0, 0); extent_p: (1, 0.13, 0); text: "Goya Pairs"; text-size-p: 0.7; }
      @cell intro { id: "intro"; position_p: (0, 0.14, 0); extent_p: (1, 0.12, 0); text: "Find the eight pairs. Arrow keys move between cards; OK turns one over."; wrap: 46; text-size-p: 0.26; }
      @cell pairs_line { id: "status.pairs"; position_p: (0, 0.30, 0); extent_p: (1, 0.07, 0); text: "Pairs: "; text-from: state.pairs; text-size-p: 0.6; }
      @cell moves_line { id: "status.moves"; position_p: (0, 0.38, 0); extent_p: (1, 0.07, 0); text: "Moves: "; text-from: state.moves; text-size-p: 0.6; }
      @cell games_line { id: "status.games"; position_p: (0, 0.46, 0); extent_p: (1, 0.07, 0); text: "Games won: "; text-from: state.games; text-size-p: 0.6; }
      @cell hint_0 { id: "hint.0"; present-when: state.phase is 0; position_p: (0, 0.56, 0); extent_p: (1, 0.07, 0); text: "Pick a card."; text-size-p: 0.45; appear-s: 0.4; appear-from-p: (0.02, 0, 0); }
      @cell hint_1 { id: "hint.1"; present-when: state.phase is 1; position_p: (0, 0.56, 0); extent_p: (1, 0.07, 0); text: "Now find its pair."; text-size-p: 0.45; appear-s: 0.4; appear-from-p: (0.02, 0, 0); }
      @cell hint_2 { id: "hint.2"; present-when: state.phase is 2; position_p: (0, 0.56, 0); extent_p: (1, 0.07, 0); text: "Not a match. Press OK to turn them back."; text-size-p: 0.45; appear-s: 0.4; appear-from-p: (0.02, 0, 0); }
      @cell won { id: "won"; present-when: state.pairs at-least 8; position_p: (0, 0.64, 0); extent_p: (1, 0.1, 0); fill: #fff3c4; stroke: #e0a81e; stroke-width-p: 0.03; text: "All eight pairs found!"; text-size-p: 0.45; appear-s: 0.6; appear-from-p: (0, 0.05, 0); }
      @cell control { id: "control"; position_p: (0, 0.78, 0); extent_p: (0.6, 0.1, 0);
        @button new_0 { id: "control.new.0"; present-when: state.pair_0 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "New game"; text-size-p: 0.45; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "New game"; hint: "Deal the cards again"; } }
        @cell all_0 { id: "control.after.0"; present-when: state.pair_0 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0);
        @button new_1 { id: "control.new.1"; present-when: state.pair_1 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "New game"; text-size-p: 0.45; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "New game"; hint: "Deal the cards again"; } }
        @cell all_1 { id: "control.after.1"; present-when: state.pair_1 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0);
        @button new_2 { id: "control.new.2"; present-when: state.pair_2 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "New game"; text-size-p: 0.45; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "New game"; hint: "Deal the cards again"; } }
        @cell all_2 { id: "control.after.2"; present-when: state.pair_2 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0);
        @button new_3 { id: "control.new.3"; present-when: state.pair_3 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "New game"; text-size-p: 0.45; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "New game"; hint: "Deal the cards again"; } }
        @cell all_3 { id: "control.after.3"; present-when: state.pair_3 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0);
        @button new_4 { id: "control.new.4"; present-when: state.pair_4 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "New game"; text-size-p: 0.45; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "New game"; hint: "Deal the cards again"; } }
        @cell all_4 { id: "control.after.4"; present-when: state.pair_4 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0);
        @button new_5 { id: "control.new.5"; present-when: state.pair_5 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "New game"; text-size-p: 0.45; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "New game"; hint: "Deal the cards again"; } }
        @cell all_5 { id: "control.after.5"; present-when: state.pair_5 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0);
        @button new_6 { id: "control.new.6"; present-when: state.pair_6 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "New game"; text-size-p: 0.45; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "New game"; hint: "Deal the cards again"; } }
        @cell all_6 { id: "control.after.6"; present-when: state.pair_6 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0);
        @button new_7 { id: "control.new.7"; present-when: state.pair_7 is false; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "New game"; text-size-p: 0.45; fill: #d9e2ec; stroke: #52606d; stroke-width-p: 0.03; @iden { label: "New game"; hint: "Deal the cards again"; } }
        @cell all_7 { id: "control.after.7"; present-when: state.pair_7 is true; position_p: (0, 0, 0); extent_p: (1, 1, 0);
        @button again_0 { id: "control.again.0"; present-when: state.deal is 0; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "Play again"; text-size-p: 0.45; fill: #fff3c4; stroke: #e0a81e; stroke-width-p: 0.03; @iden { label: "Play again"; hint: "Count this win and deal a new layout"; } }
        @button again_1 { id: "control.again.1"; present-when: state.deal is 1; position_p: (0, 0, 0); extent_p: (1, 1, 0); text: "Play again"; text-size-p: 0.45; fill: #fff3c4; stroke: #e0a81e; stroke-width-p: 0.03; @iden { label: "Play again"; hint: "Count this win and deal a new layout"; } }
        }
        }
        }
        }
        }
        }
        }
        }
      }
      @cell credit { id: "credit"; position_p: (0, 0.93, 0); extent_p: (1, 0.05, 0); text: "Written in .gscene. Cards precomputed as GY-GVI/0 by the Goya compiler."; text-size-p: 0.5; }
