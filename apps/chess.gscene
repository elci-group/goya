// chess.gscene — local two-player chess exemplar.
// Visible text stays in the 5x7 glyph set. The host fills each square.
//   cargo run -p goya-hello --bin chess -- --live

@ontology chess {

    @cell window {
        position: (0, 0, 0)
        extent: (100, 112, 0)
        fill: #1a1a1a

        @cell status_text {
            position: (6, 2, 0)
            extent: (88, 10, 0)
            fill: #2a2a2a
            text: "light"
            text-size: 12
