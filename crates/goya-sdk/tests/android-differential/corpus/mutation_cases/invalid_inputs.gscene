// Invalid inputs test file for Android differential testing - mutation cases
@ontology invalid_inputs {
    // Empty input (should be rejected)
    @cell empty_input {
        id: "empty";
        text: "";
    }
    
    // Input with very long text (potential overflow)
    @cell very_long_text {
        id: "long_text";
        text: "x".repeat(10000);
    }
    
    // Input with special characters
    @cell special_chars {
        id: "special";
        text: "!@#$%^&*()_+-=[]{}|;':\",./<>?";
    }
    
    // Input with unicode characters
    @cell unicode_text {
        id: "unicode";
        text: "Hello 世界 🌍";
    }
    
    // Input with null bytes
    @cell null_bytes {
        id: "null";
        text: "test\0null";
    }
}