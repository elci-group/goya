// Complex forms integration test file for Android differential testing
@ontology complex_forms {
    // Multi-field form with validation
    @cell first_name {
        id: "first_name";
        text: "John";
        max-length: 30;
        text-size: 18;
        fill: #4A90E2;
    }
    
    @cell last_name {
        id: "last_name";
        text: "Doe";
        max-length: 30;
        text-size: 18;
        fill: #4A90E2;
    }
    
    @cell email {
        id: "email";
        text: "john.doe@example.com";
        placeholder: "john.doe@example.com";
        max-length: 100;
        text-size: 16;
        fill: #E0E0E0;
    }
    
    @cell phone_number {
        id: "phone_number";
        text: "(555) 123-4567";
        placeholder: "(555) 123-4567";
        max-length: 20;
    }
    
    @cell address {
        id: "address";
        text: "123 Main Street, New York, NY 10001";
        placeholder: "123 Main Street, City, State ZIP";
        max-length: 200;
        text-size: 14;
    }
    
    @cell city {
        id: "city";
        text: "New York";
        placeholder: "City name";
        max-length: 50;
    }
    
    @cell zip_code {
        id: "zip_code";
        text: "10001";
        placeholder: "ZIP code";
        max-length: 10;
    }
}