// Max length inputs test file for Android differential testing
@ontology max_length_inputs {
    // Username with max length 50
    @cell username {
        id: "username";
        text: "a".repeat(50);
        max-length: 50;
    }
    
    // Password with max length 20
    @cell password {
        id: "password";
        text: "b".repeat(20);
        max-length: 20;
    }
    
    // Email with max length 100
    @cell email {
        id: "email";
        text: "c".repeat(100);
        max-length: 100;
    }
    
    // Very long text field
    @cell long_text {
        id: "long_text";
        text: "x".repeat(200);
        max-length: 200;
    }
    
    // Short text with max length 5
    @cell short {
        id: "short";
        text: "xyz";
        max-length: 5;
    }
}