// Placeholder inputs test file for Android differential testing
@ontology placeholder_inputs {
    // Input with placeholder text
    @cell name {
        id: "name";
        text: "John Doe";
        placeholder: "Enter full name";
    }
    
    // Email input with placeholder
    @cell user_email {
        id: "user_email";
        text: "john@example.com";
        placeholder: "name@example.com";
    }
    
    // Phone number input
    @cell phone {
        id: "phone";
        text: "+1234567890";
        placeholder: "(123) 456-7890";
    }
    
    // Address input
    @cell address {
        id: "address";
        text: "123 Main St, City, State 12345";
        placeholder: "123 Main St, Anytown, USA";
    }
    
    // Comment/textarea input
    @cell comments {
        id: "comments";
        text: "This is a comment";
        placeholder: "Add a comment...";
    }
}