{
    "performance_benchmarks": {
        "generation_performance": {
            "basic_inputs": {
                "max_execution_time_ms": 100,
                "max_memory_usage_mb": 10,
                "performance_target": "fast"
            },
            "placeholder_inputs": {
                "max_execution_time_ms": 50,
                "max_memory_usage_mb": 5,
                "performance_target": "very_fast"
            },
            "max_length_inputs": {
                "max_execution_time_ms": 200,
                "max_memory_usage_mb": 15,
                "performance_target": "fast"
            },
            "complex_forms": {
                "max_execution_time_ms": 300,
                "max_memory_usage_mb": 25,
                "performance_target": "acceptable"
            }
        },
        "validation_performance": {
            "input_validation": {
                "max_execution_time_ms": 20,
                "max_memory_usage_mb": 2,
                "performance_target": "very_fast"
            },
            "format_validation": {
                "max_execution_time_ms": 30,
                "max_memory_usage_mb": 3,
                "performance_target": "fast"
            },
            "regex_validation": {
                "max_execution_time_ms": 40,
                "max_memory_usage_mb": 4,
                "performance_target": "fast"
            }
        },
        "mutation_testing_performance": {
            "invalid_inputs_test": {
                "max_execution_time_ms": 150,
                "max_memory_usage_mb": 20,
                "performance_target": "acceptable"
            },
            "boundary_conditions_test": {
                "max_execution_time_ms": 100,
                "max_memory_usage_mb": 15,
                "performance_target": "fast"
            }
        },
        "regression_detection": {
            "performance_threshold_multiplier": 2,
            "memory_threshold_multiplier": 2,
            "execution_time_threshold_multiplier": 1.5,
            "alert_on_degradation": true,
            "auto_report": true
        }
    },
    "benchmark_config": {
        "runs_per_test": 5,
        "warmup_runs": 2,
        "measurement_runs": 3,
        "timeout_seconds": 30,
        "collect_memory_metrics": true,
        "collect_cpu_metrics": false,
        "generate_performance_report": true
    }
}