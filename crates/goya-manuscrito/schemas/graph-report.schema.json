{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goya.invalid/schemas/manuscrito-graph-report-1.json",
  "title": "Manuscrito TypeScript project graph report",
  "type": "object",
  "required": ["schema", "status", "diagnostics"],
  "properties": {
    "schema": { "const": "goya.manuscrito.graph/1" },
    "status": { "enum": ["ok", "failed"] },
    "typescript_version": { "type": "string" },
    "project_root": { "type": "string" },
    "config_file": { "type": "string" },
    "compiler_options": { "type": "object" },
    "project_references": { "type": "array" },
    "modules": { "type": "array", "items": { "type": "string" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "loader_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "start", "end", "kind", "expression", "reason"],
        "properties": {
          "source": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["dynamic-import", "require", "module-require"] },
          "expression": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      }
    },
    "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "type_diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "mir": {
      "type": "object",
      "required": ["version", "status", "nodes"],
      "properties": {
        "version": { "const": "goya.manuscrito.mir/1" },
        "status": { "const": "extraction-only" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/mirNode" } }
      }
    },
    "capability_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "start", "end", "module", "capability", "operation", "status"],
        "properties": {
          "source": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "module": { "type": ["string", "null"] },
          "capability": { "type": ["string", "null"] },
          "operation": { "type": "string" },
          "status": { "enum": ["recognized", "unclassified"] }
        }
      }
    },
    "reachable_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "resolved_version", "declared_version_constraint", "classification", "translation_status", "imports"],
        "properties": {
          "name": { "type": "string" },
          "resolved_version": { "type": ["string", "null"] },
          "declared_version_constraint": { "type": ["string", "null"] },
          "classification": { "const": "unclassified" },
          "translation_status": { "const": "not-translated" },
          "imports": { "type": "array", "items": { "type": "object", "required": ["source", "specifier", "resolved"], "properties": { "source": { "type": "string" }, "specifier": { "type": "string" }, "resolved": { "type": ["string", "null"] } } } }
        }
      }
    },
    "lockfile": {
      "type": "object",
      "required": ["manager", "version", "status", "source_digest", "root_manifest_mismatches", "integrity_issues_count"],
      "properties": {
        "manager": { "const": "npm" },
        "version": { "type": ["integer", "null"] },
        "status": { "enum": ["missing", "parsed", "unsupported", "invalid"] },
        "source_digest": { "type": ["string", "null"] },
        "root_manifest_mismatches": { "type": "array", "items": { "type": "object", "required": ["name", "manifest", "lockfile"], "properties": { "name": { "type": "string" }, "manifest": { "type": "string" }, "lockfile": { "type": ["string", "null"] } } } },
        "integrity_issues_count": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "dependency_closure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "install_path", "integrity_present", "integrity_format_valid", "integrity", "resolved", "link", "dev", "optional", "peer", "classification", "reachable_from"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "install_path": { "type": "string" },
          "integrity_present": { "type": "boolean" },
          "integrity_format_valid": { "type": "boolean" },
          "integrity": { "type": ["string", "null"] },
          "resolved": { "type": ["string", "null"] },
          "link": { "type": "boolean" },
          "dev": { "type": "boolean" },
          "optional": { "type": "boolean" },
          "peer": { "type": "boolean" },
          "classification": { "const": "unclassified" },
          "reachable_from": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "dependency_closure_unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "importer", "reason"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "importer": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "strongly_connected_components": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
    "cycles": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
    "coverage": {
      "type": "object",
      "required": ["resolved_edges", "unresolved_edges", "total_edges"],
      "properties": {
        "resolved_edges": { "type": "integer", "minimum": 0 },
        "unresolved_edges": { "type": "integer", "minimum": 0 },
        "total_edges": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "required": ["source", "start", "end", "specifier", "kind", "resolved", "external", "unresolved"],
      "properties": {
        "source": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "specifier": { "type": "string" },
        "kind": { "enum": ["import", "re-export", "dynamic-import", "require", "module-require"] },
        "resolved": { "type": ["string", "null"] },
        "external": { "type": ["boolean", "null"] },
        "package_name": { "type": ["string", "null"] },
        "package_version": { "type": ["string", "null"] },
        "unresolved": { "type": "boolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "file": { "type": ["string", "null"] },
        "start": { "type": ["integer", "null"] }
      }
    },
    "symbol": {
      "type": "object",
      "required": ["source", "start", "end", "name", "kind", "exported", "type", "parameters", "return_type"],
      "properties": {
        "source": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "kind": { "enum": ["function", "class", "interface", "type-alias", "enum", "variable"] },
        "exported": { "type": "boolean" },
        "type": { "type": "string" },
        "parameters": { "type": "array", "items": { "type": "object", "required": ["name", "type"], "properties": { "name": { "type": "string" }, "type": { "type": "string" } } } },
        "return_type": { "type": ["string", "null"] }
      }
    },
    "mirNode": {
      "type": "object",
      "required": ["id", "parent", "function", "kind", "source", "start", "end", "source_digest", "verification_status", "transformation_history", "source_kind", "inferred_type", "effects"],
      "properties": {
        "id": { "type": "string" },
        "parent": { "type": ["string", "null"] },
        "function": { "type": ["string", "null"] },
        "kind": { "enum": ["function", "branch", "iteration", "suspension", "throw", "return", "invocation", "mutation", "binding"] },
        "source": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "source_digest": { "type": "string" },
        "verification_status": { "type": "string" },
        "transformation_history": { "type": "array", "items": { "type": "string" } },
        "source_kind": { "type": "string" },
        "inferred_type": { "type": ["string", "null"] },
        "async": { "type": "boolean" },
        "effects": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
