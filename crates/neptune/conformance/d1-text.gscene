@ontology acceptance {
    @state {
        saved: text = "" session;
        prior: text = "" session;
        enabled: bool = false session;
    }
    @cell root {
        id: "acceptance.root";
        @button save { id: "acceptance.save"; text: "Save"; }
        @input draft { id: "acceptance.draft"; text: ""; }
    }
    @interaction update {
        id: "acceptance.update";
        trigger: button.save.activate;
        class: D1;
        state { read saved: text; read enabled: bool; write saved: text; write prior: text; write enabled: bool; }
        input { draft: text from "acceptance.draft"; }
        set saved = input.draft;
        set prior = state.saved;
        set enabled = state.enabled;
    }
}
