{
  "name": "electron-task-manager",
  "version": "1.0.0",
  "description": "A minimal Electron + React + TypeScript task manager fixture",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc --watch -p tsconfig.json",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "preview": "npm run build && electron ."
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "task-manager",
    "fixture"
  ],
  "author": "",
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "33.2.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}