candidate live intent=broadcast.start label="Go live" risk=sensitive rank=7
candidate twin intent=open label="Twin 1" rank=8
candidate twin intent=open label="Twin 2" rank=9
candidate tv.a intent=open label="TV (tile)" entity=tv rank=10
candidate tv.b intent=open label="TV (list)" entity=tv rank=11
candidate ok intent=open label=OK rank=12
resolve now=5
expect-rejected gone unavailable
