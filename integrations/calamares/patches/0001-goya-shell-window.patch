 static QSize
 desktopSize( QWidget* w )
 {
@@ -454,6 +570,14 @@ CalamaresWindow::CalamaresWindow( QWidget* parent )
     {
         connect( m_viewManager, &Calamares::ViewManager::ensureSize, this, &CalamaresWindow::ensureSize );
     }
