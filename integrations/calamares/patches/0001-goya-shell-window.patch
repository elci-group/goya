+    {
+        auto* layout = new QVBoxLayout( baseWidget );
+        Calamares::unmarginLayout( layout );
+        layout->addWidget( goyaShell );
+        m_viewManager->setPanelSides( Qt::Vertical );
+        return;
+    }
